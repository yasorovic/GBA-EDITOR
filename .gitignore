# Python cache — généré automatiquement, jamais besoin de commiter
__pycache__/
*.py[cod]
.pytest_cache/

# Backstage — artefacts de build uniquement (générés à chaque build)
Project Demo/*/build/

# Sortie du build Nuitka — 180 Mo, régénérée par packaging/nuitka_build.py
build-out/

# Environnements virtuels locaux. `.venv-build312` reproduit la version de
# Python de la CI (3.12) pour tester un build de release sans toucher à
# l'interpréteur du poste cf. packaging/nuitka_build.py.
.venv*/

# Packaging : sorties générées par le build (voir packaging/), quel que
# soit le dossier depuis lequel la commande est lancée (racine ou packaging/)
build/
dist/
build-out*/
*.dist/
*.build/
*.onefile-build/
Backstage-*-windows-setup.exe
Backstage-*-windows-portable.zip
*.AppImage

.zed/

run.bat

proto/

# Backstage — corbeille d'un projet ouvert (vidée à la fermeture)
Project Demo/*/.temp/

# Ancienne config locale de la chaîne d'outils (désormais dans le dossier de config utilisateur)
editor/core/toolchain.json
.pytest-tmp-*/
.pytest-*-results.txt
data-audio-rom-*/

# Sorties de profilage (cProfile)
*.out

# Audio échantillonné (trop lourd pour GitHub, gardé en local).
# Les .mod/.xm/.it/.s3m (trackers, légers) restent suivis.
*.wav
*.mp3
*.ogg
*.flac
*.aif
*.aiff